SEED_IMPORT_ALLOWLIST='../src/auth/system-role-presets'

usage() {
  printf 'usage: one of\n'
  printf '  deploy-plan <backend-sha40> <frontend-sha40>   (lowercase hex)\n'
  printf '  deploy-run  <backend-sha40> <frontend-sha40>   (detached; returns deploy-id)\n'
  printf '  deploy-status [N]                              (N = 1..200)\n'
  printf '  deploy-unlock <deploy-id>\n'
}

fail() { # fail <usage|badarg|unreadable|failed|migration-class>
  printf -- '-- error %s\n' "$1"
  case "$1" in usage|badarg) exit 2 ;; *) exit 1 ;; esac
}

# Secret mask — identical policy to the read-only gateway: fail-closed,
# over-masking acceptable. Applied to ALL verb output before the cap.
mask() {
  sed -E \
    -e '/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/,/-----END [A-Z0-9 ]*PRIVATE KEY-----/d' \
    -e '/PRIVATE KEY/d' \
    -e 's#(://)[^@[:space:]]+@#\1[MASKED]@#g' \
    -e 's#(DATABASE_URL|REDIS_URL|B2_[A-Z0-9_]+|[A-Z0-9_]*(PASSWORD|SECRET|TOKEN|API_KEY|APP_KEY|KEY_ID)[A-Z0-9_]*)([[:space:]]*[=:][[:space:]]*)[^[:space:]]+#\1\3[MASKED]#g' \
    -e 's#("[A-Za-z0-9_]*([Pp]assword|[Ss]ecret|[Tt]oken|[Aa]pi[_]?[Kk]ey|[Aa]pp[_]?[Kk]ey|[Kk]ey[_]?[Ii]d)[A-Za-z0-9_]*"[[:space:]]*:[[:space:]]*)("[^"]*"|[^",[:space:]}]+)#\1"[MASKED]"#g' \
    -e 's#[Bb]earer[[:space:]]+[^[:space:]]+#Bearer [MASKED]#g' \
    -e 's#eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{4,}(\.[A-Za-z0-9_-]+)?#[MASKED-JWT]#g'
}

# ---------------------------------------------------------------------
# Pure helpers (unit-tested by the sibling test file via lib-only mode)
# ---------------------------------------------------------------------

is_sha40()      { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }
is_deploy_id()  { [[ "$1" =~ ^d[0-9]{9,12}-[0-9a-f]{4}$ ]]; }

new_deploy_id() {
  printf 'd%s-%s\n' "$(date +%s)" \
    "$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')"
}

# /proc start-identity: field 22 of /proc/<pid>/stat, parsed AFTER the
# last ')' so a comm containing spaces/parens cannot shift fields.
# PROC_ROOT is honored ONLY in lib-only (test) mode; a normal forced
# -command run always reads the real /proc.
proc_starttime() {
  local pid="$1" line rest procroot='/proc'
  if [[ "${SARGAS_DEPLOY_GW_LIB_ONLY:-0}" == '1' && -n "${PROC_ROOT:-}" ]]; then
    procroot="$PROC_ROOT"
  fi
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "$procroot/$pid/stat" ]] || return 1
  IFS= read -r line < "$procroot/$pid/stat" || return 1
  rest="${line##*) }"
  # shellcheck disable=SC2086
  set -- $rest
  [[ -n "${20:-}" ]] || return 1
  printf '%s\n' "${20}"
}

runner_alive() { # runner_alive <pid> <recorded-starttime> -> 0 iff alive AND identity matches
  local st
  st="$(proc_starttime "$1")" || return 1
  [[ "$st" == "$2" ]]
}

lock_present() { [[ -d "$LOCK_DIR" ]]; }

lock_acquire() { # lock_acquire <deploy-id> <be-sha> <fe-sha> <prev-be> <prev-fe> <pid> <starttime>
  mkdir "$LOCK_DIR" 2>/dev/null || return 1
  {
    printf 'DEPLOY_ID=%s\n'  "$1"
    printf 'BE_SHA=%s\n'     "$2"
    printf 'FE_SHA=%s\n'     "$3"
    printf 'PREV_BE=%s\n'    "$4"
    printf 'PREV_FE=%s\n'    "$5"
    printf 'PID=%s\n'        "$6"
    printf 'STARTTIME=%s\n'  "$7"
    printf 'STEP=%s\n'       '0'
    printf 'CREATED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$LOCK_META"
}

lock_get() { # lock_get <KEY> — value validated by shape before use
  [[ -r "$LOCK_META" ]] || return 1
  local v
  v="$(grep -m1 "^$1=" "$LOCK_META" 2>/dev/null)" || return 1
  printf '%s\n' "${v#*=}"
}

# state.json: strict schema; any parse/shape problem is a hard error.
STATE_KEYS='schema deployed_backend_sha previous_backend_sha published_frontend_sha previous_frontend_sha fe_release_dir previous_fe_release_dir'

state_get() { # state_get <key>; exit codes: 3 unreadable/invalid
  [[ -r "$STATE_FILE" ]] || return 3
  [[ -x "$NODE_BIN" ]] || return 3
  "$NODE_BIN" -e '
const fs = require("fs");
const file = process.argv[1], key = process.argv[2];
let o;
try { o = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(3); }
const req = ["schema","deployed_backend_sha","previous_backend_sha",
             "published_frontend_sha","previous_frontend_sha",
             "fe_release_dir","previous_fe_release_dir"];
for (const k of req) if (!(k in o)) process.exit(3);
const v = o[key];
if (v === undefined || v === null) process.exit(3);
if (typeof v !== "string" && typeof v !== "number") process.exit(3);
process.stdout.write(String(v));
' "$STATE_FILE" "$1" 2>/dev/null
}

state_valid() { state_get schema >/dev/null 2>&1; }

# Atomic full-state rewrite: values via argv (never interpolated into
# code), tmp file + rename. Caller passes all six payload fields.
state_write() { # <deployed_be> <prev_be> <published_fe> <prev_fe> <fe_rel> <prev_fe_rel>
  [[ -x "$NODE_BIN" ]] || return 3
  local tmp="$STATE_FILE.tmp.$$"
  "$NODE_BIN" -e '
const fs = require("fs");
const [file, dbe, pbe, pfe, prfe, rel, prel] = process.argv.slice(1);
const o = { schema: 1,
  deployed_backend_sha: dbe,  previous_backend_sha: pbe,
  published_frontend_sha: pfe, previous_frontend_sha: prfe,
  fe_release_dir: rel,         previous_fe_release_dir: prel };
fs.writeFileSync(file, JSON.stringify(o, null, 1) + "\n");
' "$tmp" "$1" "$2" "$3" "$4" "$5" "$6" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$STATE_FILE"
}

# ---------------------------------------------------------------------
# Migration classifier — FAIL-CLOSED ALLOWLIST heuristic.
# HONESTY CONTRACT: this classifier can only err toward blocking. It is
# NOT a semantic-safety proof — an allowed INSERT can still be wrong.
# Real guarantees remain: review, the additive-first migrations policy,
# the VERIFIED backup gate, and exact-SHA approval. Anything the
# tokenizer cannot confidently split or match is manual-required.
# ---------------------------------------------------------------------

# Single-pass character-level SQL tokenizer (awk state machine).
# States: Normal / 'string' / "identifier" / -- line comment /
# /* block comment (nested, as PostgreSQL nests them) */.
# String and identifier CONTENT is discarded ('LIT' / "ID"), comments
# are consumed by state — so a comment marker inside quotes, or a
# quote inside a comment, can never desync the stripper from the
# parser: they are the same automaton. `;` splits statements only in
# the Normal state (emitted as newlines). EOF in any non-Normal state
# prints DESYNC and fails. Dollar-quoting and backslashes are rejected
# by gates BEFORE this tokenizer runs.
sql_tokenize() { # stdin -> one blanked UPPER statement per line; rc 1 on desync
  awk '
    BEGIN { st = "N"; depth = 0; out = "" }
    {
      line = $0 "\n"
      i = 1
      while (i <= length(line)) {
        c = substr(line, i, 1); n = substr(line, i, 2)
        if (st == "N") {
          if (n == "--") { st = "L"; i += 2; continue }
          if (n == "/*") { st = "B"; depth = 1; i += 2; continue }
          if (c == "\047") { st = "S"; i++; continue }   # \047 = POSIX octal apostrophe (mawk has no \x)
          if (c == "\"")   { st = "D"; i++; continue }
          if (c == ";")    { out = out "\n"; i++; continue }
          if (c == "\n")   { out = out " ";  i++; continue }
          out = out c; i++; continue
        }
        if (st == "L") { if (c == "\n") { st = "N"; out = out " " }; i++; continue }
        if (st == "B") {
          if (n == "/*") { depth++; i += 2; continue }
          if (n == "*/") { depth--; i += 2; if (depth == 0) { st = "N"; out = out " " }; continue }
          i++; continue
        }
        if (st == "S") {
          if (n == "\047\047") { i += 2; continue }
          if (c == "\047") { st = "N"; out = out "\047LIT\047"; i++; continue }
          i++; continue
        }
        if (st == "D") {
          if (n == "\"\"") { i += 2; continue }
          if (c == "\"") { st = "N"; out = out "\"ID\""; i++; continue }
          i++; continue
        }
      }
    }
    END {
      if (st != "N" || depth != 0) { print "DESYNC"; exit 1 }
      printf "%s", out
    }
  ' | tr '[:lower:]' '[:upper:]' | sed -e 's/[[:space:]]\{1,\}/ /g'
}

sql_strip_parens() { # remove (...) groups iteratively (for comma check)
  local s="$1" prev=''
  while [[ "$s" != "$prev" ]]; do
    prev="$s"
    s="$(printf '%s' "$s" | sed 's/([^()]*)//g')"
  done
  printf '%s\n' "$s"
}

classify_sql_stream() { # stdin: migration.sql; stdout: verdict lines; rc 0=auto 1=manual
  local raw blanked manual=0 stmt check stripped nonempty=0
  raw="$(cat)"
  # Gate 1: dollar-quoting lets '--' and ';' live inside literals, and
  # PostgreSQL allows non-ASCII letters in $tag$ names — no character
  # class is trustworthy. Fail closed on ANY '$' in the raw stream.
  if printf '%s' "$raw" | grep -q '\$'; then
    printf '  manual: dollar sign present — dollar-quoting cannot be ruled out\n'
    return 1
  fi
  # Gate 2: backslashes (E'\'' escape strings and friends) would need
  # escape-aware string parsing; standard DDL never requires them.
  if printf '%s' "$raw" | grep -q '\\'; then
    printf '  manual: backslash present — escape-string parsing not attempted\n'
    return 1
  fi
  # Single-automaton tokenize: comments, strings and identifiers are
  # resolved in one pass, so no marker hidden inside quotes (or quote
  # hidden inside a comment) can desync stripping from parsing.
  if ! blanked="$(printf '%s\n' "$raw" | sql_tokenize)"; then
    printf '  manual: tokenizer desync (unterminated string/identifier/comment)\n'
    return 1
  fi
  while IFS= read -r stmt; do
    stmt="${stmt#"${stmt%%[![:space:]]*}"}"
    stmt="${stmt%"${stmt##*[![:space:]]}"}"
    [[ -z "$stmt" ]] && continue
    nonempty=1
    # Statements arrive already blanked ('LIT' / "ID") by the tokenizer.
    check="$stmt"
    if [[ "$check" == ALTER\ TABLE\ * ]]; then
      # Multi-clause ALTER TABLE is auto-eligible ONLY when EVERY
      # clause matches an explicitly additive shape (prisma routinely
      # emits "ADD COLUMN a, ADD COLUMN b"). Any other clause — DROP,
      # RENAME, SET NOT NULL, SET DATA TYPE, anything unrecognized —
      # fails the whole statement closed.
      stripped="$(sql_strip_parens "$check")"
      local clause first=1 bad_clause=0
      local OLDIFS2="$IFS"
      IFS=','
      # shellcheck disable=SC2086
      set -- $stripped
      IFS="$OLDIFS2"
      for clause in "$@"; do
        clause="${clause#"${clause%%[![:space:]]*}"}"
        clause="${clause%"${clause##*[![:space:]]}"}"
        if (( first == 1 )); then
          first=0
          if [[ "$clause" =~ ^ALTER\ TABLE\ .*\ ADD\ COLUMN\  ]] \
          || [[ "$clause" =~ ^ALTER\ TABLE\ .*\ ADD\ CONSTRAINT\  ]] \
          || [[ "$clause" =~ ^ALTER\ TABLE\ .*\ ALTER\ COLUMN\ .*\ (SET|DROP)\ DEFAULT ]]; then
            continue
          fi
        else
          if [[ "$clause" =~ ^ADD\ COLUMN\  ]] \
          || [[ "$clause" =~ ^ADD\ CONSTRAINT\  ]] \
          || [[ "$clause" =~ ^ALTER\ COLUMN\ .*\ (SET|DROP)\ DEFAULT ]]; then
            continue
          fi
        fi
        bad_clause=1
        break
      done
      if (( bad_clause == 0 )); then
        continue
      fi
      printf '  manual: ALTER TABLE clause outside additive allowlist: %.60s...\n' "$stmt"
      manual=1; continue
    fi
    if [[ "$check" =~ ^CREATE\ (UNIQUE\ )?INDEX(\ CONCURRENTLY)?(\ IF\ NOT\ EXISTS)?\  ]] \
    || [[ "$check" =~ ^CREATE\ TABLE(\ IF\ NOT\ EXISTS)?\  ]] \
    || [[ "$check" =~ ^CREATE\ TYPE\  ]] \
    || [[ "$check" =~ ^CREATE\ SEQUENCE(\ IF\ NOT\ EXISTS)?\  ]] \
    || [[ "$check" =~ ^CREATE\ EXTENSION\ IF\ NOT\ EXISTS\  ]] \
    || [[ "$check" =~ ^ALTER\ TYPE\ .*\ ADD\ VALUE ]] \
    || [[ "$check" =~ ^INSERT\ INTO\  ]] \
    || [[ "$check" =~ ^COMMENT\ ON\  ]]; then
      continue
    fi
    printf '  manual: unrecognized statement: %.60s...\n' "$stmt"
    manual=1
  done <<< "$blanked"
  if (( nonempty == 0 )); then
    printf '  manual: empty or unreadable migration SQL\n'
    return 1
  fi
  return "$manual"
}

classify_sql_file() { # <path>; rc 0=auto 1=manual 3=unreadable
  [[ -r "$1" ]] || return 3
  classify_sql_stream < "$1"
}

# ---------------------------------------------------------------------
# Deltas (computed against fetched objects; read-only on the repo)
# ---------------------------------------------------------------------

# Deltas are computed FROM the recorded deployed/published base, not
# from repo HEAD: after a partial failure (e.g. backend healthy,
# frontend build failed) HEAD already equals the target, but DB work
# that never ran must still be detected on retry — and work that DID
# run (deployed advanced) must not repeat.
migration_delta() { # <repo> <base> <sha> -> prints new migration dir names
  timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$1" diff --name-only "$2..$3" -- prisma/migrations 2>/dev/null \
    | sed -n 's#^prisma/migrations/\([^/]*\)/.*#\1#p' | sort -u
}

extract_rel_imports() { # stdin: TS source -> relative import specifiers
  grep -oE "from[[:space:]]+['\"]\.\.?/[^'\"]+['\"]|require\(['\"]\.\.?/[^'\"]+['\"]\)" 2>/dev/null \
    | sed -E "s/.*['\"](\.\.?\/[^'\"]+)['\"].*/\1/" | sort -u
}

seed_delta() { # <repo> <base> <sha>; rc 0 delta present, 1 none; prints reasons
  local repo="$1" base="$2" sha="$3" changed imp bad=0
  changed="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" diff --name-only "$base..$sha" -- "${SEED_WATCH_PATHS[@]}" 2>/dev/null)"
  if [[ -n "$changed" ]]; then
    printf '%s\n' "$changed" | sed 's/^/  changed: /'
    bad=1
  fi
  # Import guard: any relative import outside the allowlist in the
  # TARGET revision's seed files over-triggers seed_delta (fail closed).
  while IFS= read -r imp; do
    [[ -z "$imp" ]] && continue
    if [[ "$imp" != "$SEED_IMPORT_ALLOWLIST" ]]; then
      printf '  import-guard: seed-system.ts imports %s (outside allowlist)\n' "$imp"
      bad=1
    fi
  done < <(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" show "$sha:prisma/seed-system.ts" 2>/dev/null | extract_rel_imports)
  while IFS= read -r imp; do
    [[ -z "$imp" ]] && continue
    printf '  import-guard: system-role-presets.ts gained an import: %s\n' "$imp"
    bad=1
  done < <(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" show "$sha:src/auth/system-role-presets.ts" 2>/dev/null | extract_rel_imports)
  (( bad == 1 )) && return 0
  return 1
}

# ---------------------------------------------------------------------
# Verbs
# ---------------------------------------------------------------------

plan_fail() { printf 'plan: BLOCKED — %s\n' "$1"; return "${2:-1}"; }

v_deploy_plan() { # <be-sha> <fe-sha>  (non-release-mutating preflight)
  local be="$1" fe="$2" b repo sha tip head dirty branch dep
  printf 'deploy-plan (non-release-mutating preflight; remote-tracking refs may update, nothing else)\n'

  for b in "$NODE_BIN" "$NPM_BIN" "$GIT_BIN" "$PM2_BIN"; do
    [[ -x "$b" ]] || { plan_fail "pinned binary missing: $b" 3; return 3; }
  done
  printf 'binaries: ok\n'

  local use
  use="$(df -P "$CRM_ROOT" 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')" \
    || { plan_fail "df failed for $CRM_ROOT" 3; return 3; }
  [[ "$use" =~ ^[0-9]+$ ]] || { plan_fail 'disk usage unparseable' 3; return 3; }
  (( use < DISK_MAX_USE_PCT )) || { plan_fail "disk ${use}% >= ${DISK_MAX_USE_PCT}%"; return 1; }
  printf 'disk: %s%% used\n' "$use"

  state_valid || { plan_fail "state file missing/invalid: $STATE_FILE (initialized at install — Card 3)" 3; return 3; }
  printf 'state: valid (schema %s)\n' "$(state_get schema)"

  if [[ -n "${UNDER_LOCK_ID:-}" ]]; then
    # Re-validation performed by the runner that already owns the lock.
    local own
    own="$(lock_get DEPLOY_ID)" || { plan_fail 'under-lock preflight: lock meta unreadable'; return 1; }
    [[ "$own" == "$UNDER_LOCK_ID" ]] \
      || { plan_fail "under-lock preflight: lock belongs to $own"; return 1; }
    printf 'lock: held by this runner (%s)\n' "$own"
  else
    lock_present && { plan_fail 'another deploy holds the lock (see deploy-status)'; return 1; }
    printf 'lock: absent\n'
  fi

  for repo in "$BACKEND_DIR" "$FRONTEND_DIR"; do
    case "$repo" in
      "$BACKEND_DIR")  sha="$be"; dep="$(state_get deployed_backend_sha)"  ;;
      *)               sha="$fe"; dep="$(state_get published_frontend_sha)" ;;
    esac
    [[ -d "$repo/.git" ]] || { plan_fail "repo missing: $repo" 3; return 3; }
    branch="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)" \
      || { plan_fail "cannot read branch in $repo" 3; return 3; }
    [[ "$branch" == main ]] || { plan_fail "$repo is on '$branch', expected main"; return 1; }
    dirty="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" status --porcelain 2>/dev/null)" \
      || { plan_fail "git status failed in $repo" 3; return 3; }
    [[ -z "$dirty" ]] || { plan_fail "$repo working tree not clean"; return 1; }
    timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" fetch origin main >/dev/null 2>&1 \
      || { plan_fail "git fetch failed in $repo"; return 1; }
    tip="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" rev-parse origin/main 2>/dev/null)" \
      || { plan_fail "cannot resolve origin/main in $repo"; return 1; }
    [[ "$tip" == "$sha" ]] || { plan_fail "requested SHA is not the origin/main tip in ${repo##*/} (tip: $tip)"; return 1; }
    head="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" rev-parse HEAD 2>/dev/null)"
    timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" merge-base --is-ancestor HEAD "$sha" 2>/dev/null \
      || [[ "$head" == "$sha" ]] \
      || { plan_fail "fast-forward impossible in ${repo##*/} (HEAD $head)"; return 1; }
    if [[ "$head" != "$dep" && "$head" != "$sha" ]]; then
      plan_fail "state/HEAD mismatch in ${repo##*/}: HEAD $head, deployed $dep — resolve manually"
      return 1
    fi
    printf 'repo %s: branch main, clean, tip match, ff ok (HEAD %.12s, deployed %.12s)\n' \
      "${repo##*/}" "$head" "$dep"
  done

  # Frontend publish invariant (prepared by the operator in Card 3):
  # dist must already be a symlink resolving INSIDE fe-releases/ —
  # otherwise an atomic swap is impossible and we fail closed before
  # any mutation.
  local dist_real releases_real
  if [[ ! -L "$FRONTEND_DIR/dist" ]]; then
    plan_fail "frontend dist is not a symlink (one-time operator migration pending)"; return 1
  fi
  dist_real="$(realpath -- "$FRONTEND_DIR/dist" 2>/dev/null)" \
    || { plan_fail 'frontend dist symlink does not resolve'; return 1; }
  # Canonicalize BOTH sides of the prefix check (/var vs /private/var
  # style aliasing must not break containment).
  releases_real="$(realpath -- "$FE_RELEASES" 2>/dev/null)" \
    || { plan_fail "fe-releases root missing: $FE_RELEASES"; return 1; }
  case "$dist_real" in
    "$releases_real"/*) printf 'fe-dist: symlink inside fe-releases (%s)\n' "${dist_real##*/}" ;;
    *) plan_fail "frontend dist resolves outside fe-releases: $dist_real"; return 1 ;;
  esac

  # DB baseline. Real prisma (>=4.3) exits 1 on MERELY-PENDING
  # migrations too — and after a transient post-ff failure HEAD already
  # equals the target, so pending == exactly the deployed..target delta
  # and the retry must be allowed. Fail closed on anything that smells
  # like a FAILED migration (canon path C is manual), on unparseable
  # output, and on pending in a non-retry position.
  local mig_out mig_rc=0 head_be
  mig_out="$(cd "$BACKEND_DIR" && timeout "$VERB_TIMEOUT" "$PRISMA_BIN" migrate status --config=./prisma.config.ts 2>&1)" || mig_rc=$?
  head_be="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$BACKEND_DIR" rev-parse HEAD 2>/dev/null)"
  if (( mig_rc == 0 )); then
    printf 'db-baseline: up to date against current HEAD\n'
  elif printf '%s' "$mig_out" | grep -qi 'failed'; then
    printf '%s\n' "$mig_out" | tail -n 5
    plan_fail 'failed migration recorded in the database — manual path C required'
    return 1
  elif [[ "$head_be" == "$be" ]] \
    && printf '%s' "$mig_out" | grep -qi 'have not yet been applied'; then
    printf 'db-baseline: pending migrations consistent with a retry (HEAD already at target)\n'
  else
    printf '%s\n' "$mig_out" | tail -n 5
    plan_fail 'current DB is not clean against deployed HEAD'
    return 1
  fi

  # Deltas + classifier — computed from the recorded deployed base.
  local base_be mnames m rc_class=0 any_manual=0 migd=0 seedd=0
  base_be="$(state_get deployed_backend_sha)"
  mnames="$(migration_delta "$BACKEND_DIR" "$base_be" "$be")"
  if [[ -n "$mnames" ]]; then
    migd=1
    printf 'migration_delta:\n'
    while IFS= read -r m; do
      [[ -z "$m" ]] && continue
      printf ' migration %s:\n' "$m"
      local msql=''
      msql="$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$BACKEND_DIR" show "$be:prisma/migrations/$m/migration.sql" 2>/dev/null)" || msql=''
      if [[ -z "$msql" ]]; then
        printf '  manual: migration.sql missing or unreadable at target SHA\n'
        printf '  verdict: manual-required\n'
        any_manual=1
      elif printf '%s\n' "$msql" | classify_sql_stream; then
        printf '  verdict: auto-eligible\n'
      else
        printf '  verdict: manual-required\n'
        any_manual=1
      fi
    done <<< "$mnames"
  else
    printf 'migration_delta: none\n'
  fi

  printf 'seed_delta:\n'
  if seed_delta "$BACKEND_DIR" "$base_be" "$be"; then
    seedd=1
  else
    printf '  none\n'
  fi

  local needs=false
  (( migd == 1 || seedd == 1 )) && needs=true
  printf 'needs_db_write: %s (migration_delta=%s seed_delta=%s)\n' "$needs" "$migd" "$seedd"
  if [[ "$needs" == true ]]; then
    printf 'backup: a fresh PRE_MIGRATION backup + --current-run-id gate will be REQUIRED before any DB op\n'
  fi

  if (( any_manual == 1 )); then
    plan_fail 'migration-class manual-required — route this release through the operator path'
    return 4
  fi
  printf 'plan: OK for %.12s / %.12s\n' "$be" "$fe"
  return 0
}

# ---------------------------------------------------------------------
# Detached runner (Card 2). Spawned once per deploy-run as its own
# session (setsid): survives the SSH disconnect, journals every step,
# holds the lock on failure, and only ever runs the fixed argv below.
# ---------------------------------------------------------------------

RUN_JOURNAL=''

jraw() { printf '%s\n' "$*" >> "$RUN_JOURNAL"; }

lock_set_step() { # <step-label> — atomic meta rewrite
  local tmp="$LOCK_META.tmp.$$"
  { grep -v '^STEP=' "$LOCK_META" 2>/dev/null; printf 'STEP=%s\n' "$1"; } > "$tmp" \
    && mv -f -- "$tmp" "$LOCK_META"
}

step_run() { # step_run <label> <timeout> <cmd...> ; output masked into journal
  local label="$1" t="$2"; shift 2
  jraw "== step $label =="
  lock_set_step "$label"
  set +e
  timeout "$t" "$@" 2>&1 | mask >> "$RUN_JOURNAL"
  local rc=${PIPESTATUS[0]}
  set -e
  if (( rc != 0 )); then
    jraw "== step $label FAILED (rc=$rc) =="
    jraw "FAILED@$label"
  fi
  return "$rc"
}

step_run_in() { # step_run_in [-pub] <dir> <label> <timeout> <cmd...>
  # -pub: run under umask 022 — the step produces PUBLIC artifacts
  # (nginx must read them); everything else keeps the gateway's 077.
  local pub=''
  if [[ "$1" == '-pub' ]]; then pub=1; shift; fi
  local dir="$1"; shift
  local label="$1" t="$2"; shift 2
  jraw "== step $label =="
  lock_set_step "$label"
  set +e
  ( cd "$dir" || exit 1
    if [[ -n "$pub" ]]; then umask 022; fi
    timeout "$t" "$@" ) 2>&1 | mask >> "$RUN_JOURNAL"
  local rc=${PIPESTATUS[0]}
  set -e
  if (( rc != 0 )); then
    jraw "== step $label FAILED (rc=$rc) =="
    jraw "FAILED@$label"
  fi
  return "$rc"
}

backend_health_poll() { # rc 0 iff /health returns 200 within the window
  local waited=0 code
  while (( waited < HEALTH_TIMEOUT )); do
    code="$("$CURL_BIN" -fsS -o /dev/null -w '%{http_code}' --max-time 5 "$BACKEND_HEALTH_URL" 2>/dev/null)" || code='000'
    jraw "health poll: $code"
    [[ "$code" == 200 ]] && return 0
    sleep "$HEALTH_SLEEP"
    waited=$(( waited + HEALTH_SLEEP ))
  done
  return 1
}

runner_main() { # <deploy-id> <be-sha> <fe-sha>
  local id="$1" be="$2" fe="$3"
  RUN_JOURNAL="$JOURNAL_DIR/$id.log"
  mkdir -p "$JOURNAL_DIR"
  umask 077

  # Step 1: lock meta — our own pid + /proc start identity.
  local st prev_be prev_fe
  st="$(proc_starttime $$)" || st='0'
  prev_be="$(state_get deployed_backend_sha)" || prev_be='?'
  prev_fe="$(state_get published_frontend_sha)" || prev_fe='?'
  {
    printf 'DEPLOY_ID=%s\n'  "$id"
    printf 'BE_SHA=%s\n'     "$be"
    printf 'FE_SHA=%s\n'     "$fe"
    printf 'PREV_BE=%s\n'    "$prev_be"
    printf 'PREV_FE=%s\n'    "$prev_fe"
    printf 'PID=%s\n'        "$$"
    printf 'STARTTIME=%s\n'  "$st"
    printf 'STEP=%s\n'       '1-lock'
    printf 'CREATED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$LOCK_META"
  jraw "deploy $id: backend $be frontend $fe (runner pid $$, starttime $st)"

  # Step 2: full preflight again, under the held lock — no TOCTOU.
  jraw '== step 2-preflight =='
  lock_set_step '2-preflight'
  set +e
  UNDER_LOCK_ID="$id" v_deploy_plan "$be" "$fe" 2>&1 | mask >> "$RUN_JOURNAL"
  local rc=${PIPESTATUS[0]}
  set -e
  if (( rc != 0 )); then jraw "FAILED@2-preflight"; exit 1; fi

  # Recompute the DB decision from the recorded deployed base.
  local base_be mnames migd=0 seedd=0
  base_be="$(state_get deployed_backend_sha)"
  mnames="$(migration_delta "$BACKEND_DIR" "$base_be" "$be")"
  [[ -n "$mnames" ]] && migd=1
  if seed_delta "$BACKEND_DIR" "$base_be" "$be" >> "$RUN_JOURNAL"; then seedd=1; fi
  jraw "needs_db_write: migration_delta=$migd seed_delta=$seedd (base $base_be)"

  # Step 3: backend fast-forward + deps + build.
  step_run '3-be-fetch' "$VERB_TIMEOUT" "$GIT_BIN" -C "$BACKEND_DIR" fetch origin main || exit 1
  step_run '3-be-ff'    "$VERB_TIMEOUT" "$GIT_BIN" -C "$BACKEND_DIR" merge --ff-only "$be" || exit 1
  step_run_in "$BACKEND_DIR" '3-be-npm-ci'   "$BUILD_TIMEOUT" "$NPM_BIN" ci || exit 1
  step_run_in "$BACKEND_DIR" '3-be-generate' "$BUILD_TIMEOUT" "$PRISMA_BIN" generate --config=./prisma.config.ts || exit 1
  step_run_in "$BACKEND_DIR" '3-be-build'    "$BUILD_TIMEOUT" "$NPM_BIN" run build || exit 1

  # Steps 4–7: DB writes happen ONLY behind a fresh VERIFIED backup.
  if (( migd == 1 || seedd == 1 )); then
    jraw '== step 4-backup =='
    lock_set_step '4-backup'
    local bjson bid bstatus bkey bsum
    set +e
    bjson="$( cd "$BACKEND_DIR" && BACKUP_TYPE=PRE_MIGRATION BACKUP_TRIGGER=sargas-claude-deploy-gw \
              timeout "$DB_TIMEOUT" "$TSNODE_BIN" scripts/backup.ts 2>&1 )"
    rc=$?
    set -e
    printf '%s\n' "$bjson" | mask >> "$RUN_JOURNAL"
    if (( rc != 0 )); then jraw 'FAILED@4-backup'; exit 1; fi
    # Parse the canonical JSON report (scripts/backup.ts): id, status,
    # artifactKey, checksum — values extracted by node, never by shell.
    read -r bid bstatus bkey bsum < <(printf '%s' "$bjson" | "$NODE_BIN" -e '
let d = "";
process.stdin.on("data", (c) => (d += c));
process.stdin.on("end", () => {
  const m = d.match(/\{[\s\S]*\}/);
  if (!m) process.exit(1);
  let o; try { o = JSON.parse(m[0]); } catch { process.exit(1); }
  if (o.ok !== true) process.exit(1);
  const f = [o.id, o.status, o.artifactKey, o.checksum];
  if (f.some((x) => typeof x !== "string" || !x.length)) process.exit(1);
  process.stdout.write(f.join(" ") + "\n");
});') || { jraw 'backup report unparseable'; jraw 'FAILED@4-backup'; exit 1; }
    if [[ "$bstatus" != 'VERIFIED' ]]; then
      jraw "backup status is '$bstatus', not VERIFIED"; jraw 'FAILED@4-backup'; exit 1
    fi
    jraw "backup VERIFIED: id=$bid artifact=$bkey checksum=${bsum:0:12}…"
    step_run_in "$BACKEND_DIR" '5-backup-gate' "$DB_TIMEOUT" \
      "$TSNODE_BIN" scripts/require-fresh-backup.ts --pre-migration "--current-run-id=$bid" || exit 1
    if (( migd == 1 )); then
      step_run_in "$BACKEND_DIR" '6-migrate-deploy' "$DB_TIMEOUT" \
        "$PRISMA_BIN" migrate deploy --config=./prisma.config.ts || exit 1
    else
      jraw 'step 6-migrate-deploy skipped (no migration delta)'
    fi
    if (( seedd == 1 )); then
      step_run_in "$BACKEND_DIR" '7-seed-system' "$DB_TIMEOUT" "$NPM_BIN" run seed:system || exit 1
    else
      jraw 'step 7-seed-system skipped (no seed delta)'
    fi
  else
    jraw 'steps 4-7 skipped (no DB-writing delta)'
  fi

  # Step 8: restart ONLY the backend process, pinned daemon-compatible PM2.
  step_run '8-restart' "$VERB_TIMEOUT" env PATH="${PM2_BIN%/*}:/usr/bin:/bin" "$PM2_BIN" restart sales-crm-back-end || exit 1

  # Step 9: bounded health; frontend is NOT touched until green.
  jraw '== step 9-health =='
  lock_set_step '9-health'
  if ! backend_health_poll; then jraw 'FAILED@9-health'; exit 1; fi
  if (( migd == 1 )); then
    step_run_in "$BACKEND_DIR" '9-migrate-status' "$DB_TIMEOUT" \
      "$PRISMA_BIN" migrate status --config=./prisma.config.ts || exit 1
  fi
  # On a retry prev_be already equals the target; keep the real
  # previous instead of recording previous==deployed.
  local keep_prev_be="$prev_be"
  [[ "$keep_prev_be" == "$be" ]] && keep_prev_be="$(state_get previous_backend_sha)"
  state_write "$be" "$keep_prev_be" "$(state_get published_frontend_sha)" \
    "$(state_get previous_frontend_sha)" "$(state_get fe_release_dir)" \
    "$(state_get previous_fe_release_dir)" \
    || { jraw 'FAILED@9-state-write'; exit 1; }
  jraw "deployed_backend_sha -> $be"

  # Step 10–12: frontend into an isolated release dir; live dist untouched.
  local rel="$FE_RELEASES/$id"
  step_run '10-fe-fetch' "$VERB_TIMEOUT" "$GIT_BIN" -C "$FRONTEND_DIR" fetch origin main || exit 1
  step_run '10-fe-ff'    "$VERB_TIMEOUT" "$GIT_BIN" -C "$FRONTEND_DIR" merge --ff-only "$fe" || exit 1
  step_run_in "$FRONTEND_DIR" '11-fe-npm-ci' "$BUILD_TIMEOUT" "$NPM_BIN" ci --legacy-peer-deps || exit 1
  step_run_in "$FRONTEND_DIR" '11-fe-tsc'    "$BUILD_TIMEOUT" "$FE_TSC_BIN" --noEmit || exit 1
  mkdir -p -- "$rel"
  chmod 755 "$rel"   # public release root (abs path): nginx must traverse it
  step_run_in -pub "$FRONTEND_DIR" '11-fe-vite' "$BUILD_TIMEOUT" "$FE_VITE_BIN" build --outDir "$rel" || exit 1
  jraw '== step 12-fe-artifacts =='
  lock_set_step '12-fe-artifacts'
  if [[ ! -f "$rel/index.html" ]] || [[ -z "$(ls -A -- "$rel/assets" 2>/dev/null)" ]]; then
    jraw 'release artifacts missing (index.html / assets)'; jraw 'FAILED@12-fe-artifacts'; exit 1
  fi

  # Step 13: atomic symlink cutover (rename over the old link).
  jraw '== step 13-fe-swap =='
  lock_set_step '13-fe-swap'
  local old_rel tmp_link
  old_rel="$(realpath -- "$FRONTEND_DIR/dist" 2>/dev/null)" || old_rel=''
  tmp_link="$FRONTEND_DIR/dist.tmp.$id"
  ln -s -- "$rel" "$tmp_link"
  if ! mv -T -- "$tmp_link" "$FRONTEND_DIR/dist" 2>/dev/null; then
    # BSD mv (tests on macOS) has -h instead of GNU -T.
    mv -h -- "$tmp_link" "$FRONTEND_DIR/dist" 2>/dev/null \
      || { rm -f -- "$tmp_link"; jraw 'atomic swap failed'; jraw 'FAILED@13-fe-swap'; exit 1; }
  fi
  if [[ "$(realpath -- "$FRONTEND_DIR/dist")" != "$(realpath -- "$rel")" ]]; then
    jraw 'post-swap verification failed'; jraw 'FAILED@13-fe-swap'; exit 1
  fi
  jraw "dist -> $rel (previous: ${old_rel:-?})"

  # Step 14: frontend health. A failed probe must NOT leave the
  # potentially broken new release live: atomically roll the dist
  # symlink back to the previous release, re-probe, and never run
  # retention — both release dirs are retained either way.
  jraw '== step 14-fe-health =='
  lock_set_step '14-fe-health'
  local fcode
  fcode="$("$CURL_BIN" -sS -o /dev/null -w '%{http_code}' --max-time 5 "$FRONTEND_PROBE_URL" 2>/dev/null)" || fcode='000'
  jraw "frontend probe: $fcode"
  if [[ "$fcode" != 200 ]]; then
    jraw "frontend probe failed ($fcode) — attempting atomic rollback to previous release"
    lock_set_step '14-fe-rollback'
    local rb_ok=0 rb_tmp="$FRONTEND_DIR/dist.rb.$id" rcode
    if [[ -n "$old_rel" && -d "$old_rel" ]]; then
      ln -s -- "$old_rel" "$rb_tmp"
      if mv -T -- "$rb_tmp" "$FRONTEND_DIR/dist" 2>/dev/null \
         || mv -h -- "$rb_tmp" "$FRONTEND_DIR/dist" 2>/dev/null; then
        [[ "$(realpath -- "$FRONTEND_DIR/dist" 2>/dev/null)" == "$(realpath -- "$old_rel" 2>/dev/null)" ]] \
          && rb_ok=1
      else
        rm -f -- "$rb_tmp"
      fi
    else
      jraw "previous release missing or unknown (${old_rel:-?}) — cannot roll back"
    fi
    if (( rb_ok == 1 )); then
      rcode="$("$CURL_BIN" -sS -o /dev/null -w '%{http_code}' --max-time 5 "$FRONTEND_PROBE_URL" 2>/dev/null)" || rcode='000'
      jraw "post-rollback probe: $rcode"
      if [[ "$rcode" == 200 ]]; then
        jraw 'rollback: dist restored to previous release; old frontend serving again'
        jraw 'FAILED@14-fe-health (rolled back; both releases retained; retention skipped; published unchanged)'
        exit 1
      fi
      jraw 'rollback swap succeeded but the probe still fails'
    fi
    lock_set_step '14-fe-health-MANUAL-INTERVENTION'
    jraw 'MANUAL-INTERVENTION-REQUIRED: frontend unhealthy and rollback failed or unverified; both release dirs retained; lock held'
    jraw 'FAILED@14-fe-health'
    exit 1
  fi
  state_write "$(state_get deployed_backend_sha)" "$(state_get previous_backend_sha)" \
    "$fe" "$prev_fe" "$rel" "${old_rel:-?}" \
    || { jraw 'FAILED@14-state-write'; exit 1; }
  jraw "published_frontend_sha -> $fe"

  # Step 15: retention — keep current + previous + the 3 newest
  # id-patterned releases; 'initial' and anything non-id-shaped is
  # never touched; deletions only as validated basenames under the
  # fixed FE_RELEASES root.
  jraw '== step 15-prune =='
  lock_set_step '15-prune'
  local keep_cur keep_prev name kept=0
  keep_cur="${rel##*/}"
  keep_prev="${old_rel##*/}"
  while IFS= read -r name; do
    [[ "$name" =~ ^d[0-9]{9,12}-[0-9a-f]{4}$ ]] || continue
    [[ "$name" == "$keep_cur" || "$name" == "$keep_prev" ]] && continue
    kept=$(( kept + 1 ))
    if (( kept > 3 )); then
      jraw "prune: removing fe-releases/$name"
      rm -rf -- "$FE_RELEASES/$name"
    fi
  done < <(ls -1t -- "$FE_RELEASES" 2>/dev/null)

  jraw 'DEPLOYED'
  jraw "final: backend $be frontend $fe release $rel"
  rm -rf -- "$LOCK_DIR"
  logger -t sargas-claude-deploy-gw -- "runner deploy_id=$id result=DEPLOYED" 2>/dev/null || true
  exit 0
}

v_deploy_run() { # <be-sha> <fe-sha> — validate, lock, spawn, return id
  local be="$1" fe="$2" rc=0
  # Pre-lock preflight: the client sees the full plan output; any
  # failure (incl. migration-class manual-required) aborts before any
  # lock or spawn.
  set +e
  v_deploy_plan "$be" "$fe"
  rc=$?
  set -e
  (( rc == 0 )) || return "$rc"

  mkdir "$LOCK_DIR" 2>/dev/null \
    || { printf 'deploy-run: another deploy holds the lock (deploy-status for details)\n'; return 1; }

  local id self
  id="$(new_deploy_id)"
  self="${BASH_SOURCE[0]}"
  mkdir -p "$JOURNAL_DIR"
  # Full detach: own session via setsid (prod, util-linux). macOS test
  # machines lack setsid — a double-fork subshell reparents the runner
  # to init, which equally survives the dispatcher's exit.
  local -a spawn_cmd
  spawn_cmd=( bash "$self" )
  [[ -n "$TEST_ROOT" ]] && spawn_cmd+=( --test-root "$TEST_ROOT" )
  spawn_cmd+=( --runner "$id" "$be" "$fe" )
  if command -v setsid >/dev/null 2>&1; then
    setsid "${spawn_cmd[@]}" < /dev/null >> "$STATE_DIR/runner-spawn.err" 2>&1 &
    disown 2>/dev/null || true
  else
    ( "${spawn_cmd[@]}" < /dev/null >> "$STATE_DIR/runner-spawn.err" 2>&1 & ) &
    wait $! 2>/dev/null || true
  fi

  # Wait for the runner to write its own meta (pid+starttime). If it
  # never does, release OUR meta-less lock before reporting: the
  # runner writes meta as its very first act, so removing the dir
  # makes any late-starting runner die on its first write — before
  # any mutation — and the gateway is never left with an
  # ununlockable lock.
  local waited=0
  while (( waited < 50 )); do
    [[ -s "$LOCK_META" ]] && break
    sleep 0.1 2>/dev/null || sleep 1
    waited=$(( waited + 1 ))
  done
  if [[ ! -s "$LOCK_META" ]]; then
    rm -rf -- "$LOCK_DIR"
    printf 'deploy-run: runner did not start in time; lock released (spawn log kept server-side)\n'
    return 1
  fi

  printf 'deploy-id: %s\n' "$id"
  printf 'runner: detached (observe with deploy-status)\n'
}

v_deploy_status() { # <N>
  local n="$1" id pid st verdict k v
  printf '== lock ==\n'
  if lock_present; then
    for k in DEPLOY_ID BE_SHA FE_SHA PREV_BE PREV_FE STEP CREATED_AT; do
      v="$(lock_get "$k")" || v='?'
      printf '%s: %s\n' "$k" "$v"
    done
    pid="$(lock_get PID)" || pid=''
    st="$(lock_get STARTTIME)" || st=''
    if [[ "$pid" =~ ^[0-9]+$ && -n "$st" ]] && runner_alive "$pid" "$st"; then
      verdict="alive (pid $pid, starttime match)"
    elif [[ "$pid" =~ ^[0-9]+$ ]] && proc_starttime "$pid" >/dev/null 2>&1; then
      verdict="dead (pid $pid reused — starttime mismatch)"
    else
      verdict="dead (no such process)"
    fi
    printf 'runner: %s\n' "$verdict"
  else
    printf 'lock: absent\n'
  fi

  printf '== state ==\n'
  if state_valid; then
    for k in deployed_backend_sha previous_backend_sha published_frontend_sha previous_frontend_sha fe_release_dir; do
      printf '%s: %s\n' "$k" "$(state_get "$k")"
    done
  else
    printf 'state: missing/invalid (%s)\n' "$STATE_FILE"
  fi

  printf '== repo heads ==\n'
  local repo
  for repo in "$BACKEND_DIR" "$FRONTEND_DIR"; do
    if [[ -d "$repo/.git" ]]; then
      printf 'repo_head %s: %s\n' "${repo##*/}" \
        "$(timeout "$VERB_TIMEOUT" "$GIT_BIN" -C "$repo" rev-parse HEAD 2>/dev/null || echo '?')"
    else
      printf 'repo_head %s: repo not found\n' "${repo##*/}"
    fi
  done

  printf '== journal (last %s lines) ==\n' "$n"
  local latest
  latest="$(ls -1t "$JOURNAL_DIR" 2>/dev/null | head -n1)"
  if [[ -n "$latest" && -r "$JOURNAL_DIR/$latest" ]]; then
    printf '[%s]\n' "$latest"
    tail -n "$n" -- "$JOURNAL_DIR/$latest"
  else
    printf 'journal: none\n'
  fi
}

v_deploy_unlock() { # <deploy-id>
  local want="$1" have pid st
  lock_present || { printf 'unlock: no lock present\n'; return 1; }
  have="$(lock_get DEPLOY_ID)" || { printf 'unlock: lock meta unreadable\n'; return 1; }
  if [[ "$have" != "$want" ]]; then
    printf 'unlock: deploy-id mismatch (lock holds %s)\n' "$have"
    return 1
  fi
  pid="$(lock_get PID)" || pid=''
  st="$(lock_get STARTTIME)" || st=''
  if [[ "$pid" =~ ^[0-9]+$ && -n "$st" ]] && runner_alive "$pid" "$st"; then
    printf 'unlock: REFUSED — runner pid %s is alive with matching start identity\n' "$pid"
    return 1
  fi
  # Fail closed where start-identity is unavailable (no /proc): a
  # merely-alive pid must still refuse — "proven dead" or nothing.
  # Uses the same lib-gated proc root as proc_starttime so unit tests
  # with a fake /proc exercise the identity path, not this one.
  local _procroot='/proc'
  if [[ "${SARGAS_DEPLOY_GW_LIB_ONLY:-0}" == '1' && -n "${PROC_ROOT:-}" ]]; then
    _procroot="$PROC_ROOT"
  fi
  if [[ "$pid" =~ ^[0-9]+$ && ! -d "$_procroot/self" ]] && kill -0 "$pid" 2>/dev/null; then
    printf 'unlock: REFUSED — process %s is alive and start identity cannot be verified on this platform\n' "$pid"
    return 1
  fi
  # Only the fixed constant path is ever removed; user input is compared,
  # never used to build a path.
  rm -rf -- "$LOCK_DIR"
  printf 'unlock: removed lock %s (runner proven dead)\n' "$want"
}

# ---------------------------------------------------------------------
# Runner self-invocation (argv-only; unreachable via sshd). Grammar
# -validate the internal arguments too — fail closed, silently.
# ---------------------------------------------------------------------
if (( RUNNER_MODE == 1 )); then
  is_deploy_id "$RUNNER_ID" || exit 2
  is_sha40 "$RUNNER_BE"     || exit 2
  is_sha40 "$RUNNER_FE"     || exit 2
  runner_main "$RUNNER_ID" "$RUNNER_BE" "$RUNNER_FE"
  exit 1   # unreachable: runner_main always exits
fi

# ---------------------------------------------------------------------
# Lib-only gate for the sibling test file (env unreachable via sshd;
# worst case if set server-side: the gateway no-ops — fail closed).
# ---------------------------------------------------------------------
if [[ "${SARGAS_DEPLOY_GW_LIB_ONLY:-0}" == '1' ]]; then
  return 0 2>/dev/null || exit 0
fi

# ---------------------------------------------------------------------
# Parser — whole-string grammar over SSH_ORIGINAL_COMMAND.
# ---------------------------------------------------------------------

RAW="${SSH_ORIGINAL_COMMAND:-}"

if (( ${#RAW} > MAX_CMD_LEN )); then usage; fail usage; fi
case "$RAW" in
  *[![:print:]]*) usage; fail usage ;;
esac

VERB=''
ARG1=''
ARG2=''
STATUS_N=40
case "$RAW" in
  deploy-status)
    VERB=deploy-status
    ;;
  'deploy-status '*)
    VERB=deploy-status
    ARG1="${RAW#deploy-status }"
    case "$ARG1" in ''|*[!0-9]*) usage; fail badarg ;; esac
    [[ "$ARG1" =~ ^([1-9][0-9]?|1[0-9][0-9]|200)$ ]] || { usage; fail badarg; }
    STATUS_N="$ARG1"
    ;;
  'deploy-plan '*|'deploy-run '*)
    case "$RAW" in
      deploy-plan*) VERB=deploy-plan; rest="${RAW#deploy-plan }" ;;
      *)            VERB=deploy-run;  rest="${RAW#deploy-run }"  ;;
    esac
    [[ "$rest" == *' '* ]] || { usage; fail badarg; }
    ARG1="${rest%% *}"
    ARG2="${rest#* }"
    [[ "$ARG2" != *' '* ]] || { usage; fail badarg; }
    is_sha40 "$ARG1" || { usage; fail badarg; }
    is_sha40 "$ARG2" || { usage; fail badarg; }
    ;;
  'deploy-unlock '*)
    VERB=deploy-unlock
    ARG1="${RAW#deploy-unlock }"
    is_deploy_id "$ARG1" || { usage; fail badarg; }
    ;;
  deploy-plan|deploy-run|deploy-unlock)
    usage; fail badarg
    ;;
  *)
    usage; fail usage
    ;;
esac
readonly VERB ARG1 ARG2 STATUS_N

run_verb() {
  case "$VERB" in
    deploy-plan)   v_deploy_plan "$ARG1" "$ARG2" ;;
    deploy-run)    v_deploy_run "$ARG1" "$ARG2" ;;
    deploy-status) v_deploy_status "$STATUS_N" ;;
    deploy-unlock) v_deploy_unlock "$ARG1" ;;
  esac
}

set +e
run_verb 2>&1 | mask | head -c "$MAX_OUTPUT_BYTES"
rc=${PIPESTATUS[0]}
set -e

logger -t sargas-claude-deploy-gw -- "verb=$VERB rc=$rc" 2>/dev/null || true

if (( rc == 0 )); then
  printf -- '-- ok\n'
  exit 0
elif (( rc == 3 )); then
  fail unreadable
elif (( rc == 4 )); then
  fail migration-class
else
  fail failed
fi
