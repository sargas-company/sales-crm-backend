# APP_ENV controls runtime posture. Allowed values: local, production.
# Never inferred from NODE_ENV or DATABASE_URL.
APP_ENV=local

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_dashboard"

# --- Production shape (commented reference; do not enable alongside the local block) ---
# APP_ENV=production
# DATABASE_URL="postgresql://<user>:<password>@<prod-host>:5432/<db-name>"

API_PORT=3000
# CORS allowlist — one or two origins, no trailing slash.
# Local:      http://localhost:5173
# Production: https://admin.sargas.io
CORS_ORIGIN_1=
CORS_ORIGIN_2=

NODE_ENV=development


# JWT_SECRET / JWT_REFRESH_SECRET — generate separately in production:
#   openssl rand -base64 48   # paste a different value into each of the two
# Never reuse the local placeholder on prod and never commit a real value.
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=

INVOICE_GENERATOR_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379

DISCORD_WEBHOOK_URL=

# ─── Credentials vault master key ────────────────────────────────────────────
# The credential vault stores human-account secrets AES-256-GCM-encrypted at
# the application layer before writing to Postgres. The DB never sees
# plaintext; a leaked backup is unreadable without this key.
#
# Generate a fresh 32-byte key with:
#   openssl rand -base64 32
#
# Then paste the base64 result (a 44-character string) below. Do NOT commit
# it. In production this variable should be sourced from a secret manager
# (KMS/Key Vault/1Password), never a plain .env file — the placeholder here
# only exists so local dev boots.
#
# Rotation: to introduce v2, add CREDENTIAL_VAULT_MASTER_KEY_V2 alongside V1.
# The service will keep V1 readable and start writing new rows under V2.
CREDENTIAL_VAULT_MASTER_KEY_V1=

# WebAuthn (passkey) relying-party identity. These must match the origin
# the frontend runs on — otherwise the browser refuses the ceremony.
#   • VAULT_RP_NAME:   Human-visible label shown on the passkey prompt.
#   • VAULT_RP_ID:     Domain (no scheme / port), used as WebAuthn RP-ID.
#   • VAULT_RP_ORIGIN: Full origin, including scheme + port.
# Local:
#   VAULT_RP_ID=localhost
#   VAULT_RP_ORIGIN=http://localhost:5173
# Production:
#   VAULT_RP_ID=admin.sargas.io
#   VAULT_RP_ORIGIN=https://admin.sargas.io
VAULT_RP_NAME=Sargas CRM
VAULT_RP_ID=localhost
VAULT_RP_ORIGIN=http://localhost:5173

# Backblaze B2 Storage
B2_KEY_ID=
B2_APP_KEY=
B2_DOWNLOAD_URL=                    # optional; auto-detected from authorize() response if blank

# Backup-only B2 credentials. These are used ONLY by
# scripts/backup.ts, scripts/prune-backups.ts, scripts/restore.ts and
# scripts/mark-stuck-running.ts, and are expected to be scoped to the
# `DB_DUMPS` bucket with minimal file capabilities. The backend
# runtime never reads these — if a request path needs backup bytes,
# it is a bug. Fallback to the general B2_KEY_ID/B2_APP_KEY pair is
# allowed only when APP_ENV=local, so a developer laptop can run
# backup scripts without juggling two key pairs.
B2_BACKUP_KEY_ID=
B2_BACKUP_APP_KEY=

B2_BUCKET_INVOICES_ID=
B2_BUCKET_INVOICES_NAME=
B2_BUCKET_CLIENT_REQUESTS_ID=
B2_BUCKET_CLIENT_REQUESTS_NAME=
B2_BUCKET_DB_DUMPS_ID=
B2_BUCKET_DB_DUMPS_NAME=
# New private buckets introduced by the file-layer stabilisation.
# Both MUST be allPrivate on B2; the API only hands out short-lived
# signed URLs after an authorized read.
B2_BUCKET_PORTFOLIO_ID=
B2_BUCKET_PORTFOLIO_NAME=
B2_BUCKET_AVATARS_ID=
B2_BUCKET_AVATARS_NAME=

# Signed-URL TTLs per bucket, in seconds. Omit to use defaults
# (avatars 86400, portfolio / client-requests / invoices 900).
# DB_DUMPS is not exposed through user endpoints — this value is a
# safety default only.
B2_SIGNED_TTL_AVATARS_SECONDS=86400
B2_SIGNED_TTL_PORTFOLIO_SECONDS=900
B2_SIGNED_TTL_CLIENT_REQUESTS_SECONDS=900
B2_SIGNED_TTL_INVOICES_SECONDS=900

# Discord notifications. Backup / prune / restore scripts prefer
# DISCORD_OPS_WEBHOOK_URL; DISCORD_WEBHOOK_URL is kept as a legacy
# fallback so existing deployments keep sending alerts.
DISCORD_OPS_WEBHOOK_URL=

# Discord Integration (slash command `/report` + scheduled
# notifications). ONLY these three live in env — the backend never
# surfaces them to the frontend. All non-secret routing data
# (guild id, channel ids, role id, schedules, timezone) is stored
# per-profile in the DiscordProfile table and edited from the
# Owner-only Settings page.
#
#   DISCORD_APP_ID       — the Application ID of your Discord bot.
#                          Used by the interactions-webhook follow-up
#                          calls and by scripts/register-discord-commands.ts.
#   DISCORD_PUBLIC_KEY   — Ed25519 public key printed in the Developer
#                          Portal. Used by the interactions endpoint
#                          to verify every incoming request.
#   DISCORD_BOT_TOKEN    — Bot token. Used by the scheduler to post
#                          outbound messages via the Discord Bot API
#                          and by the register-commands CLI.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Retention for `BackupRun` artifacts + manifest in the DB_DUMPS
# bucket. Runs older than this window are candidates for prune, with
# the single exception that the most recent successful backup is
# always preserved. Applies uniformly to CRON / MANUAL / PRE_DEPLOY
# / PRE_MIGRATION types.
BACKUP_RETENTION_DAYS=365

#pg
PG_DUMP_BIN=/opt/homebrew/opt/postgresql@16/bin/pg_dump
# or on ubuntu
# PG_DUMP_BIN=/usr/lib/postgresql/16/bin/pg_dump


# Sentry
APP_VERSION=
SENTRY_DSN=
